# Application Server
PORT=8080
APP_ENV=development

# Credential Encryption (AES-256-GCM: exactly 32 bytes required)
ENCRYPTION_KEY=12345678901234567890123456789012

# Initial Platform Admin Bootstrap (used on first empty DB run)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@Secure123!

# Platform Database (PostgreSQL)
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_NAME=platform_db
PLATFORM_DB_SSLMODE=disable

# Target PostgreSQL (for Phase 2 & 3)
TARGET_PG_HOST=127.0.0.1
TARGET_PG_PORT=5433
TARGET_PG_USER=postgres
TARGET_PG_PASSWORD=postgres
TARGET_PG_NAME=target_db
TARGET_PG_SSLMODE=disable

# Target MySQL (for Phase 2 & 3)
TARGET_MYSQL_HOST=127.0.0.1
TARGET_MYSQL_PORT=3306
TARGET_MYSQL_USER=root
TARGET_MYSQL_PASSWORD=rootpassword
TARGET_MYSQL_NAME=target_db
