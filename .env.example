# Application Server
PORT=8080
APP_ENV=development
SPA_DIST_DIR=frontend/dist
WORKER_ID=worker-1
METRICS_PORT=9091

# Credential Encryption (AES-256-GCM: exactly 32 bytes required)
ENCRYPTION_KEY=12345678901234567890123456789012

# Initial Platform Admin Bootstrap (used on first empty DB run)
ADMIN_INITIAL_USERNAME=admin
# Required on the first boot: set a private password before starting the server.
ADMIN_INITIAL_PASSWORD=

# Platform Database (PostgreSQL)
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_NAME=platform_db
PLATFORM_DB_SSLMODE=disable

# Target PostgreSQL 1 (utama)
TARGET_PG_HOST=127.0.0.1
TARGET_PG_PORT=5433
TARGET_PG_USER=postgres
TARGET_PG_PASSWORD=postgres
TARGET_PG_NAME=target_db
TARGET_PG_SSLMODE=disable

# Target PostgreSQL 2 (uji migrasi paralel multi-DB)
TARGET_PG2_HOST=127.0.0.1
TARGET_PG2_PORT=5434
TARGET_PG2_USER=postgres
TARGET_PG2_PASSWORD=postgres
TARGET_PG2_NAME=target_db_2
TARGET_PG2_SSLMODE=disable

# Antrean pesan RabbitMQ (durable)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# Tracing OpenTelemetry (kosongkan OTEL_EXPORTER_OTLP_ENDPOINT untuk output stdout)
OTEL_SERVICE_NAME=db-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Target MySQL lama (opsional untuk kompatibilitas M1)
TARGET_MYSQL_HOST=127.0.0.1
TARGET_MYSQL_PORT=3306
TARGET_MYSQL_USER=wbd_migrator
TARGET_MYSQL_PASSWORD=
TARGET_MYSQL_ROOT_PASSWORD=
TARGET_MYSQL_NAME=target_db
